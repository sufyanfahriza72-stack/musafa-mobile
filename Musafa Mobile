    function applyExamModeUI(isActive) {
      const titleHariIni = document.getElementById('titleHariIni');
      const titleBesok = document.getElementById('titleBesok');
      const boxHariIni = document.getElementById('boxJadwalHariIni');
      const boxBesok = document.getElementById('boxJadwalBesok');
      const toggleEl = document.getElementById('toggleModeUjian');

      if (toggleEl) toggleEl.checked = isActive;

      if (isActive) {
        if (titleHariIni) titleHariIni.innerHTML = '<i class="fa-solid fa-file-pen me-2"></i> Jadwal Ujian Hari Ini';
        if (titleBesok) titleBesok.innerHTML = '<i class="fa-solid fa-file-lines me-2"></i> Jadwal Ujian Besok';
        if (boxHariIni) boxHariIni.className = "card p-3 mb-3 border-start border-4 border-warning";
        if (boxBesok) boxBesok.className = "card p-3 mb-4 border-start border-4 border-secondary";
      } else {
        if (titleHariIni) titleHariIni.innerHTML = '<i class="fa-solid fa-calendar-day me-2"></i> Jadwal Pelajaran Hari Ini';
        if (titleBesok) titleBesok.innerHTML = '<i class="fa-solid fa-calendar-week me-2"></i> Jadwal Pelajaran Besok';
        if (boxHariIni) boxHariIni.className = "card p-3 mb-3 border-start border-4 border-info";
        if (boxBesok) boxBesok.className = "card p-3 mb-4 border-start border-4 border-secondary";
      }
    }

    function renderDaySchedules() {
      const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      const now = new Date();
      const todayIdx = now.getDay();
      const tomorrowIdx = (todayIdx + 1) % 7;
      const todayName = days[todayIdx];
      const tomorrowName = days[tomorrowIdx];

      const currentMinutes = now.getHours() * 60 + now.getMinutes();

      const parseEndMinutes = (jamStr) => {
        if (!jamStr || !jamStr.includes('-')) return 1440;
        const endPart = jamStr.split('-')[1].trim();
        const normalizedTime = endPart.replace('.', ':');
        const timeParts = normalizedTime.split(':');
        if (timeParts.length >= 2) {
          return parseInt(timeParts[0], 10) * 60 + parseInt(timeParts[1], 10);
        }
        return 1440;
      };

      const sourceData = isExamActive ? (appData.ujian || []) : (appData.jadwal || []);

      const elHariIni = document.getElementById('jadwalHariIni');
      if (elHariIni) {
        elHariIni.innerHTML = '';

        if (todayName === 'Sabtu' || todayName === 'Minggu') {
          elHariIni.innerHTML = `
            <div class="alert alert-success text-center mb-0 shadow-sm" role="alert">
              <i class="fa-solid fa-umbrella-beach fa-2x mb-2 d-block"></i>
              <strong>SEKOLAH LIBUR, SAATNYA BERSENANG SENANG DENGAN KELUARGA, SAHABAT, DAN MASYARAKAT</strong>
            </div>`;
        } else {
          const listToday = sourceData.filter(j => j.Hari === todayName);
          const activeToday = listToday.filter(j => parseEndMinutes(j.Jam) > currentMinutes);

          if (listToday.length === 0) {
            elHariIni.innerHTML = `<small class="text-muted">Tidak ada ${isExamActive ? 'jadwal ujian' : 'jadwal pelajaran'} diinput untuk hari ini.</small>`;
          } else if (activeToday.length === 0) {
            elHariIni.innerHTML = `
              <div class="alert alert-info text-center mb-0 shadow-sm" role="alert">
                <i class="fa-solid fa-house-user fa-2x mb-2 d-block"></i>
                <strong>SEKOLAH HARI INI SUDAH SELESAI, SAATNYA PULANG, HATI HATI DIJALAN</strong>
              </div>`;
          } else {
            activeToday.forEach(j => {
              const guruInfo = j.NamaGuru && j.NamaGuru !== '-' ? ` | ${j.NamaGuru}` : '';
              elHariIni.innerHTML += `
                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                  <div>
                    <span class="fw-bold">${j.MataPelajaran}</span>
                    <br><small class="text-muted"><i class="fa-regular fa-clock me-1"></i>${j.Jam}${guruInfo}</small>
                  </div>
                </div>
              `;
            });
          }
        }
      }

      const elBesok = document.getElementById('jadwalBesok');
      if (elBesok) {
        elBesok.innerHTML = '';

        if (tomorrowName === 'Sabtu' || tomorrowName === 'Minggu') {
          elBesok.innerHTML = `
            <div class="alert alert-secondary text-center mb-0" role="alert">
              <small class="fw-bold">Besok (${tomorrowName}) libur sekolah.</small>
            </div>`;
        } else {
          const listTomorrow = sourceData.filter(j => j.Hari === tomorrowName);
          if (listTomorrow.length === 0) {
            elBesok.innerHTML = `<small class="text-muted">Tidak ada ${isExamActive ? 'jadwal ujian' : 'jadwal pelajaran'} diinput untuk besok.</small>`;
          } else {
            listTomorrow.forEach(j => {
              const guruInfo = j.NamaGuru && j.NamaGuru !== '-' ? ` | ${j.NamaGuru}` : '';
              elBesok.innerHTML += `
                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                  <div>
                    <span class="fw-bold">${j.MataPelajaran}</span>
                    <br><small class="text-muted"><i class="fa-regular fa-clock me-1"></i>${j.Jam}${guruInfo}</small>
                  </div>
                </div>
              `;
            });
          }
        }
      }
    }

