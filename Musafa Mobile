    function editAgenda(rowId) {
      const item = (appData.agenda || []).find(x => String(x.rowId) === String(rowId));
      if (!item) return;
      document.getElementById('agRowId').value = item.rowId;
      document.getElementById('agJudul').value = (item.Judul || '').replace(/ \(Full Day.*?\)/, '');
      document.getElementById('agLokasi').value = item.Lokasi || '';
      document.getElementById('agJatuhTempo').value = item.JatuhTempo ? item.JatuhTempo.substring(0, 16) : '';
      document.getElementById('agPrioritas').value = item.Prioritas || 'DINAS';
      document.getElementById('agStatus').value = item.Status || 'Agendakan';
      
      toggleDisposisi(item.Status);
      if (item.Status === 'Disposisi') {
        const dispVal = item.Disposisi || '';
        if (dispVal === 'WAKIL KETUA' || dispVal === 'SEKRETARIS') {
          document.getElementById('agDisposisiTarget').value = dispVal;
          toggleDisposisiLain(dispVal);
        } else {
          document.getElementById('agDisposisiTarget').value = 'OPSI LAIN';
          toggleDisposisiLain('OPSI LAIN');
          document.getElementById('agDisposisiText').value = dispVal;
        }
      }
      document.getElementById('agTamu').value = item.Tamu || '';
      showTab('agenda');
    }

    function editTugas(rowId) {
      const item = (appData.tugas || []).find(x => String(x.rowId) === String(rowId));
      if (!item) return;
      document.getElementById('tgRowId').value = item.rowId;
      document.getElementById('tgMapel').value = item.MataPelajaran || '';
      document.getElementById('tgGuru').value = item.NamaGuru || '';
      document.getElementById('tgDeadline').value = item.Deadline ? item.Deadline.substring(0, 16) : '';
      document.getElementById('tgDetail').value = item.Detail || '';
