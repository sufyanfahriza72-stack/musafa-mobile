    function showTab(tabName) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('d-none'));
      document.getElementById(`tab-${tabName}`).classList.remove('d-none');
      if (tabName === 'dashboard') {
        loadData();
      }
    }

    function toggleDisposisi(val) {
      const isDisposisi = (val === 'Disposisi');
      document.getElementById('disposisiGroup').classList.toggle('d-none', !isDisposisi);
      if (isDisposisi) {
        toggleDisposisiLain(document.getElementById('agDisposisiTarget').value);
      }
    }

    function toggleDisposisiLain(targetVal) {
      const isLain = (targetVal === 'OPSI LAIN');
      document.getElementById('disposisiLainGroup').classList.toggle('d-none', !isLain);
    }

    function submitAgenda(e) {
      e.preventDefault();
      const isFullDay = document.getElementById('isFullDay').checked;
      const durasiDays = isFullDay ? document.getElementById('agDurasi').value : '0';
      const startVal = document.getElementById('agJatuhTempo').value;

      let finalJatuhTempo = startVal;
      if (isFullDay && startVal) {
        const daysAdd = parseInt(durasiDays);
        const startDate = new Date(startVal);
        const endDate = new Date(startDate.getTime() + (daysAdd * 24 * 60 * 60 * 1000));
        finalJatuhTempo = endDate.toISOString().substring(0, 16);
      }

      const statusVal = document.getElementById('agStatus').value;
      let finalDisposisi = '';
      if (statusVal === 'Disposisi') {
        const targetVal = document.getElementById('agDisposisiTarget').value;
        if (targetVal === 'OPSI LAIN') {
          finalDisposisi = document.getElementById('agDisposisiText').value;
        } else {
          finalDisposisi = targetVal;
        }
      }

      const payload = {
        pin: 'FT',
        data: {
          rowId: document.getElementById('agRowId').value,
          judul: document.getElementById('agJudul').value + (isFullDay ? ` (Full Day - ${durasiDays} Hari)` : ''),
          lokasi: document.getElementById('agLokasi').value,
          jatuhTempo: finalJatuhTempo,
          prioritas: document.getElementById('agPrioritas').value,
          status: statusVal,
          disposisi: finalDisposisi,
          tamu: document.getElementById('agTamu').value,
        }
      };

      callGasApi('saveAgenda', payload)
        .then(() => {
          alert('Agenda berhasil disimpan!');
          document.getElementById('agRowId').value = '';
          document.getElementById('isFullDay').checked = false;
          toggleFullDayOptions();
          e.target.reset();
          toggleDisposisi('Agendakan');
          loadData();
        })
        .catch(err => alert(err.message));
    }

